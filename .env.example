# Digiforce REST API root (the /api suffix is required)
DIGIFORCE_API_URL=/api
# DIGIFORCE_API_URL=/api

# Public base path for Vite assets and React Router when deployed under Digiforce.
# Use / for root-local development, or /x/admin/ when building for storage/dist-client/x/admin.
DIGIFORCE_PORTAL_BASE=/x/admin/
# DIGIFORCE_PORTAL_BASE=/x/admin/

# Keep these aligned with the main Digiforce frontend when customized.
# API_CLIENT_STORAGE_PREFIX=DIGIFORCE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false
