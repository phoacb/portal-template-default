# Playwright always starts a dedicated Portal dev server on this port.
# DIGIFORCE_E2E_PORT=4173
# DIGIFORCE_E2E_PORT=4173

# Keep this aligned with the Portal path being tested.
# DIGIFORCE_PORTAL_BASE=/x/demo/
# DIGIFORCE_PORTAL_BASE=/x/demo/

# Point this at the real Digiforce backend used by the test.
# DIGIFORCE_E2E_API_URL=http://127.0.0.1:13000/api
# DIGIFORCE_E2E_API_URL=http://127.0.0.1:13000/api

DIGIFORCE_E2E_ACCOUNT=admin
DIGIFORCE_E2E_PASSWORD=
DIGIFORCE_E2E_AUTHENTICATOR=basic
# DIGIFORCE_E2E_ACCOUNT=digiforce
# DIGIFORCE_E2E_PASSWORD=
# DIGIFORCE_E2E_AUTHENTICATOR=basic
# DIGIFORCE_E2E_ROLE=admin
